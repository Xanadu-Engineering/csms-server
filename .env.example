# Server Configuration
PORT=3000
OCPP_PORT=9220
HOST=0.0.0.0

# WebSocket Configuration
# Set USE_SAME_PORT=true for Digital Ocean App Platform (WebSocket on same port as HTTP)
# Set USE_SAME_PORT=false or set OCPP_PORT for separate WebSocket port
USE_SAME_PORT=false

# Optional: Set these if you have a domain name
# SERVER_URL=http://your-domain.com
# WS_URL=ws://your-domain.com:9220
# For App Platform with same port: WS_URL=wss://your-domain.com/ocpp

# Environment
NODE_ENV=production

