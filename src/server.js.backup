import express from 'express';
import { WebSocketServer } from 'ws';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = 3000;
const OCPP_PORT = 9220;

// Middleware
app.use(express.json());
app.use(express.static(path.join(__dirname, '../public')));

// Store connected chargers and pending requests
const clients = new Map(); // chargePointId -> WebSocket
const pendingRequests = new Map(); // messageId -> { resolve, reject, chargePointId, command }
let messageIdCounter = 1;

console.log('🚀 CSMS Server starting...');
console.log(`📊 Dashboard: http://localhost:${PORT}`);
console.log(`🔌 OCPP WebSocket: ws://localhost:${OCPP_PORT}`);
console.log('');

// Helper function to send OCPP command to charger
function sendCommandToCharger(chargePointId, command, payload) {
  return new Promise((resolve, reject) => {
    const ws = clients.get(chargePointId);
    
    if (!ws || ws.readyState !== 1) {
      reject(new Error(`Charger ${chargePointId} is not connected`));
      return;
    }

    const msgId = String(messageIdCounter++);
    const message = JSON.stringify([2, msgId, command, payload]);
    
    console.log(`📤 [${chargePointId}] Sending: ${command}`);
    console.log(`   Payload:`, JSON.stringify(payload, null, 2));
    
    pendingRequests.set(msgId, { resolve, reject, chargePointId, command });
    ws.send(message);

    // Timeout after 30 seconds
    setTimeout(() => {
      if (pendingRequests.has(msgId)) {
        pendingRequests.delete(msgId);
        reject(new Error('Request timeout'));
      }
    }, 30000);
  });
}

// API Routes

// Get all connected chargers
app.get('/api/chargers', (req, res) => {
  const chargerList = Array.from(clients.keys()).map(id => ({
    id,
    connected: clients.get(id).readyState === 1,
    connectedAt: clients.get(id).connectedAt
  }));
  res.json({
    chargers: chargerList,
    lastUpdate: new Date(),
    count: chargerList.length
  });
});

// Get specific charger details
app.get('/api/chargers/:id', (req, res) => {
  const charger = clients.get(req.params.id);
  
  if (!charger) {
    return res.status(404).json({ error: 'Charger not found' });
  }
  
  res.json({
    id: req.params.id,
    connected: charger.readyState === 1,
    connectedAt: charger.connectedAt
  });
// Send command to charger - Remote Start Transaction
app.post('/api/chargers/:id/remote-start', async (req, res) => {
  try {
    const { idTag = 'REMOTE-TAG', connectorId = 1 } = req.body;
    const response = await sendCommandToCharger(req.params.id, 'RemoteStartTransaction', {
      idTag,
      connectorId
    });
    res.json({ success: true, response });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: 'Failed to send remote start command',
      details: error.message
    });
  }
});

// Send command to charger - Remote Stop Transaction
app.post('/api/chargers/:id/remote-stop', async (req, res) => {
  try {
    const { transactionId } = req.body;
    
    if (!transactionId) {
      return res.status(400).json({ success: false, error: 'transactionId is required' });
    }
    
    const response = await sendCommandToCharger(req.params.id, 'RemoteStopTransaction', {
      transactionId
    });
    res.json({ success: true, response });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: 'Failed to send remote stop command',
      details: error.message
    });
  }
});

// Send command to charger - Unlock Connector
app.post('/api/chargers/:id/unlock', async (req, res) => {
  try {
    const { connectorId = 1 } = req.body;
    const response = await sendCommandToCharger(req.params.id, 'UnlockConnector', {
      connectorId
    });
    res.json({ success: true, response });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: 'Failed to send unlock command',
      details: error.message
    });
  }
});

// Send command to charger - Reset
app.post('/api/chargers/:id/reset', async (req, res) => {
  try {
    const { type = 'Soft' } = req.body; // 'Soft' or 'Hard'
    const response = await sendCommandToCharger(req.params.id, 'Reset', {
      type
    });
    res.json({ success: true, response });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: 'Failed to send reset command',
      details: error.message
    });
  }
});

// Send command to charger - Change Configuration
app.post('/api/chargers/:id/change-configuration', async (req, res) => {
  try {
    const { key, value } = req.body;
    
    if (!key || !value) {
      return res.status(400).json({ success: false, error: 'key and value are required' });
    }
    
    const response = await sendCommandToCharger(req.params.id, 'ChangeConfiguration', {
      key,
      value
    });
    res.json({ success: true, response });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: 'Failed to send change configuration command',
      details: error.message
    });
  }
});

// Send command to charger - Get Configuration
app.post('/api/chargers/:id/get-configuration', async (req, res) => {
  try {
    const { key } = req.body;
    const response = await sendCommandToCharger(req.params.id, 'GetConfiguration', 
      key ? { key: [key] } : {}
    );
    res.json({ success: true, response });
  } catch (error) {
    res.status(500).json({
      success: false,
      error: 'Failed to send get configuration command',
      details: error.message
    });
  }
});

// Serve the HTML interface
app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, '../public/csms.html'));
});

// Create OCPP WebSocket Server
const wss = new WebSocketServer({ port: OCPP_PORT });

wss.on('connection', (ws, req) => {
  const chargePointId = req.url.slice(1); // Remove leading '/'
  ws.connectedAt = new Date();
  clients.set(chargePointId, ws);

  console.log(`\n🔗 New charging station connected: ${chargePointId}\n`);

  ws.on('message', async (data) => {
    try {
      const message = JSON.parse(data.toString());
      const [messageType, messageId, commandOrResponse, payload] = message;

      // Handle responses from charger (type 3)
      if (messageType === 3) {
        if (pendingRequests.has(messageId)) {
          const { resolve, command } = pendingRequests.get(messageId);
          pendingRequests.delete(messageId);
          console.log(`✅ [${chargePointId}] ${command} Response:`, commandOrResponse);
          resolve(commandOrResponse);
        }
        return;
      }

      // Handle requests from charger (type 2)
      const command = commandOrResponse;
      console.log(`📥 [${chargePointId}] Received: ${command}`);
      console.log(`   Payload:`, JSON.stringify(payload, null, 2));

      let response;

      // Handle OCPP 1.6 requests
      if (command === 'BootNotification') {
        response = {
          currentTime: new Date().toISOString(),
          interval: 10,
          status: 'Accepted',
        };
        console.log(`✅ [${chargePointId}] BootNotification Response:`, response);
      } else if (command === 'Heartbeat') {
        response = {
          currentTime: new Date().toISOString(),
        };
        console.log(`💓 [${chargePointId}] Heartbeat`);
      } else if (command === 'Authorize') {
        response = {
          idTagInfo: { status: 'Accepted' }
        };
        console.log(`🔑 [${chargePointId}] Authorize:`, response);
      } else if (command === 'StartTransaction') {
        response = {
          transactionId: Math.floor(Math.random() * 100000),
          idTagInfo: { status: 'Accepted' }
        };
        console.log(`🔌 [${chargePointId}] StartTransaction:`, response);
      } else if (command === 'StopTransaction') {
        response = {
          idTagInfo: { status: 'Accepted' }
        };
        console.log(`⏹️  [${chargePointId}] StopTransaction:`, response);
      } else {
        console.log(`⚠️  [${chargePointId}] Unhandled command: ${command}`);
        response = {};
      }

      // Send OCPP response: [3, messageId, response]
      const responseMessage = JSON.stringify([3, messageId, response]);
      ws.send(responseMessage);

    } catch (error) {
      console.error(`⚠️  Error processing message from ${chargePointId}:`, error.message);
    }
  });

  ws.on('close', () => {
    console.log(`\n❌ Charging station disconnected: ${chargePointId}\n`);
    clients.delete(chargePointId);
  });

  ws.on('error', (error) => {
    console.error(`\n⚠️  Error from ${chargePointId}:`, error.message);
  });
});

wss.on('error', (error) => {
  console.error('⚠️  WebSocket Server Error:', error.message);
});

// Start HTTP server
app.listen(PORT, () => {
  console.log('Available endpoints:');
  console.log('  GET  /api/chargers                - List all connected chargers');
  console.log('  GET  /api/chargers/:id            - Get charger details');
  console.log('  POST /api/chargers/:id/remote-start    - Start charging remotely');
  console.log('  POST /api/chargers/:id/remote-stop     - Stop charging remotely');
  console.log('  POST /api/chargers/:id/unlock          - Unlock connector');
  console.log('  POST /api/chargers/:id/reset           - Reset charger');
  console.log('  POST /api/chargers/:id/change-configuration');
  console.log('  POST /api/chargers/:id/get-configuration');
});

// Handle graceful shutdown
process.on('SIGINT', () => {
  console.log('\n\n👋 Shutting down CSMS Server...');
  wss.close();
  process.exit(0);
});
